{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CLISetup.authorizationFailed" : {
      "comment" : "Error displayed by the command-line setup model when system authorization fails. %@ is the trimmed combined stdout/stderr output from the osascript authorization process.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't complete system authorization: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成需要系统授权的操作：%@"
          }
        }
      }
    },
    "CLISetup.authorizationHint" : {
      "comment" : "Settings hint that installing or uninstalling the command link may request administrator authorization.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS may ask for an administrator's permission to install or uninstall the tool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装或卸载时，系统可能请求管理员授权。"
          }
        }
      }
    },
    "CLISetup.authorizationRequired" : {
      "comment" : "CLI installation/removal error directing the user to app settings for administrator authorization or a writable --bin-dir.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This installation directory requires administrator permission. Open Command Line and Automation in Ruri Settings to install or uninstall with authorization, or use --bin-dir to choose an existing folder you can write to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装目录需要管理员权限。请打开 Ruri“设置”中的“命令行与自动化”，完成系统授权后安装或卸载。也可用 --bin-dir 指定已有且可写入的命令目录。"
          }
        }
      }
    },
    "CLISetup.authorizeInstall" : {
      "comment" : "Reason shown in the system administrator-authorization prompt for installing the ruri link into /usr/local/bin.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri needs permission to install its command-line tool in /usr/local/bin. You can then run ruri in Terminal without setting up PATH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri 将在 /usr/local/bin 安装命令行工具。安装后即可在终端使用 ruri，无需手动配置 PATH。"
          }
        }
      }
    },
    "CLISetup.authorizeUninstall" : {
      "comment" : "Reason shown in the system administrator-authorization prompt for removing the ruri command link.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri needs permission to remove its command-line link. The app and your game data will be kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri 需要移除已安装的命令行链接。这不会删除应用或游戏数据。"
          }
        }
      }
    },
    "CLISetup.copied" : {
      "comment" : "Temporary feedback on the command-copy button after copying in settings or onboarding.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复制"
          }
        }
      }
    },
    "CLISetup.copyCommand" : {
      "comment" : "Copy-example-command button label and tooltip in command-line settings and onboarding.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy Command"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制命令"
          }
        }
      }
    },
    "CLISetup.copyDirectCommand" : {
      "comment" : "Settings button that copies a terminal command using the complete executable path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy Full Command"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制完整命令"
          }
        }
      }
    },
    "CLISetup.details" : {
      "comment" : "Disclosure-group label expanding command-line installation details in settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation Details"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装详情"
          }
        }
      }
    },
    "CLISetup.footer" : {
      "comment" : "Footer in command-line tool settings describing CLI management features and use by AI agents.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Ruri CLI to manage instances, accounts, and settings, directly or through an AI agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Ruri CLI 管理实例、账号和配置，也可供 AI 智能体调用。"
          }
        }
      }
    },
    "CLISetup.install" : {
      "comment" : "Install button label in command-line tool settings and the CLI onboarding sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Command-Line Tool"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装到终端"
          }
        }
      }
    },
    "CLISetup.installing" : {
      "comment" : "Busy-state label on the CLI onboarding install button while setup is running.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在安装…"
          }
        }
      }
    },
    "CLISetup.introduction" : {
      "comment" : "Introductory text in command-line tool settings explaining terminal access after installation. PATH is an environment variable name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the command-line tool to run ruri in Terminal without setting up PATH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装后即可在终端使用 Ruri CLI，无需配置 PATH。"
          }
        }
      }
    },
    "CLISetup.location" : {
      "comment" : "Field label for the installed command's filesystem location in settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command location"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令位置"
          }
        }
      }
    },
    "CLISetup.onboardingDetail" : {
      "comment" : "Description in the CLI onboarding sheet explaining command-line management and AI-agent use.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage instances, accounts, and settings from the command line, or let an AI agent use Ruri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过命令行管理实例、账号和配置，也可供 AI 智能体调用。"
          }
        }
      }
    },
    "CLISetup.onboardingHint" : {
      "comment" : "Hint in the CLI onboarding sheet about administrator authorization and the settings location for later installation. Preserve the intentional line break.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation may require administrator permission.\nYou can also install it later in Settings → Command Line and Automation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装时可能需要管理员授权。\n也可稍后在“设置”的“命令行与自动化”中安装。"
          }
        }
      }
    },
    "CLISetup.onboardingTitle" : {
      "comment" : "Heading in the CLI onboarding sheet before installation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Ruri in Terminal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在终端中使用 Ruri"
          }
        }
      }
    },
    "CLISetup.provided" : {
      "comment" : "Heading in command-line tool settings when a package manager puts the ruri command on PATH instead of the app. %@ is the package manager's name, such as Nix.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-line tool provided by %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具由 %@ 提供"
          }
        }
      }
    },
    "CLISetup.ready" : {
      "comment" : "Installed-state heading in command-line tool settings and the CLI onboarding sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-line tool installed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具已安装"
          }
        }
      }
    },
    "CLISetup.readyDetail" : {
      "comment" : "Installed-state instructions in command-line tool settings and onboarding, above the example terminal command.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a new terminal window and run the command below."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开新的终端窗口，运行下方命令即可开始使用。"
          }
        }
      }
    },
    "CLISetup.reinstall" : {
      "comment" : "Reinstall button in command-line installation details when installation is already available.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinstall"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新安装"
          }
        }
      }
    },
    "CLISetup.repair" : {
      "comment" : "Repair-installation button in command-line tool settings and CLI onboarding.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repair Installation"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复安装"
          }
        }
      }
    },
    "CLISetup.repairDetail" : {
      "comment" : "Settings explanation for repairing an outdated command-line link.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update the command-line link so Terminal uses this version of Ruri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新链接，让终端使用当前版本的 Ruri。"
          }
        }
      }
    },
    "CLISetup.repairTitle" : {
      "comment" : "Settings heading when the installed command-line link needs to point to the current application.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-line tool needs an update"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具需要更新"
          }
        }
      }
    },
    "CLISetup.skip" : {
      "comment" : "Dismiss/skip button in the CLI onboarding sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip for Now"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时跳过"
          }
        }
      }
    },
    "CLISetup.title" : {
      "comment" : "Default heading in the command-line tool settings section before installation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-Line Tool"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具"
          }
        }
      }
    }
  },
  "version" : "1.0"
}

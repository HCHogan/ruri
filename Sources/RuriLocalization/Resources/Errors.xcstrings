    "AppAppModelLaunching.javaRuntimeUnavailable" : {
      "comment" : "Game launch preparation error. Used for java runtime unavailable.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mojang doesn't provide the Java version this game needs. Install it manually from the Java Runtime page."

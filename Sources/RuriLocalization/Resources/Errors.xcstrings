        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mojang 未提供此版本需要的 Java，请到 Java 运行时页面手动安装。"
          }
        }
      }
    },
    "AppContentVersionView.noVersionSource" : {
      "comment" : "Content version picker error. Used for no version source.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No download source is linked to this item, so Ruri can't check its available versions."

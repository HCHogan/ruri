{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "AppAppModel.externalIndexChanged" : {
      "comment" : "App data-index persistence error. Used for external index changed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The data index was removed or replaced externally. Writing is paused. Check the data directory."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据索引已被其他程序移除或替换，已暂停保存。请检查数据文件夹。"
          }
        }
      }
    },
    "AppAppModelAccounts.accountChanged" : {
      "comment" : "Account creation, saving, or appearance-management error. Used for account changed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account was removed or changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账号已被移除或发生变化。"
          }
        }
      }
    },
    "AppAppModelAccounts.accountSaveFailed" : {
      "comment" : "Account creation, saving, or appearance-management error. Used for account save failed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account information couldn't be saved. Reopen Ruri."

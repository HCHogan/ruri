    "AppWorldDataPackPriorityView.priorityDetails" : {
      "comment" : "Shown in the World Data Pack priority editor: Priority decreases from top to bottom. For content with the same name, the higher Data Pack takes precedence. Drag or use the arrows to reorder. Changes apply the next time you enter the World.. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packs higher in the list take priority when multiple packs define the same content. Drag a pack or use the arrows to reorder. Changes take effect the next time you enter the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先级从上到下递减，同名内容以上方数据包为准。拖动或使用箭头调整，下次进入世界时生效。"
          }
        }
      }
    },

    "MonitorLogging.writeFailed" : {
      "comment" : "Game monitor console warning; %1$@ is the debug log write error description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Ruri] Debug log writing stopped: %1$@. Recent output is still retained for diagnostics."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Ruri] 已停止写入调试日志：%1$@。近期输出仍会保留，以便排查问题。"
          }
        }
      }
    },
    "NativeGameLogs.changedDuringRead" : {
      "comment" : "Native game log collection error; %1$@ is the log filename.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ changed while being read. Collect logs again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取 %1$@ 时文件发生变化，请重新收集。"
          }
        }
      }
    },
    "NativeGameLogs.collectAgain" : {
      "comment" : "Native game log collection retry action. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect Again"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新收集"
          }
        }
      }

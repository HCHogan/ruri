    "NativeGameLogs.collectionFailed" : {
      "comment" : "Native game log collection error when run ownership cannot be verified. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't verify which run the game logs belong to. The session's diagnostic records have been retained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认哪些游戏日志属于本次运行，已保留此前保存的诊断记录。"
          }
        }
      }
    },
    "NativeGameLogs.collectionHelp" : {
      "comment" : "Native game log collection explanation in the diagnostic UI. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the game's latest.log, debug.log, and crash reports for this run on demand, then redacts them for preview and export. For oversized logs, only the beginning and end are collected; logs are not continuously copied while the game runs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要时会读取游戏的 latest.log、debug.log 和本次崩溃报告，隐藏敏感信息后供预览和导出。过大的日志仅收集开头和末尾；游戏运行时不会持续复制这些日志。"
          }
        }
      }
    },
    "NativeGameLogs.gameNotStarted" : {
      "comment" : "Native game log collection notice when launch timing is unconfirmed. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No confirmed game start time is available for this run, so logs from the game directory were not collected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认本次游戏的启动时间，未收集游戏文件夹中的日志。"
          }
        }
      }
    },
    "NativeGameLogs.noMatchingLogs" : {
      "comment" : "Native game log collection notice when no matching log files exist. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No logs belonging to this run were found in the game directory. The session's diagnostic records have been retained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏文件夹中未找到属于本次运行的日志，已保留此前保存的诊断记录。"
          }
        }
      }
    },

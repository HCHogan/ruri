    "AppLaunchSettingsEditor.memoryEstimateExplain" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Estimate Explanation. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How Memory Is Estimated"
          }

      "comment" : "Launch settings explanation of debug logging. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records console output in detail, increasing resource usage and disk writes. Limited to 64 MiB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详细记录控制台输出，会增加资源占用和磁盘写入。记录上限为 64 MiB。"
          }
        }
      }
    },
    "MonitorLogging.defaultModeHelp" : {
      "comment" : "Game monitor explanation of default logging and debug mode. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri keeps launch information and a limited amount of recent output, and saves game logs if something goes wrong. For more detailed console logs, turn on debug mode in launch settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认保留启动信息和部分近期输出，游戏异常退出时会保存日志。如需更详细的控制台记录，可在启动设置中启用调试模式。"
          }
        }
      }
    },
    "MonitorLogging.reportedFailure" : {
      "comment" : "Game monitor status when the game reports failure. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game reported a launch failure or crash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏报告了启动失败或崩溃"
          }
        }
      }
    },
    "MonitorLogging.showGameLogs" : {

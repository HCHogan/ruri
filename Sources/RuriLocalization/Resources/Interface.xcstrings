    "AppModpackUpdateView.localChangesHelp" : {
      "comment" : "Shown in the Modpack update and recovery dialog: Worlds and files you added will be kept. Locally modified settings are kept by default; you can change this for each file. You can roll back after updating.. No format arguments.",

{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "AppAccountAppearanceView.appearanceChangesSaved" : {
      "comment" : "Account appearance editor: Help explaining appearance persistence and in-game refresh behavior. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes are saved to this account's authentication service. You may need to rejoin the server for your in-game appearance to update."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改会保存到此账号的认证服务。重新进入服务器后，游戏中的外观可能才会更新。"
          }
        }
      }
    },
    "AppAccountAppearanceView.appearanceError" : {

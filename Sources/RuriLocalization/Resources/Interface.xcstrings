          "stringUnit" : {
            "state" : "translated",
            "value" : "正在统计实例内容…"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateShortfall" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Insufficient system memory: content needs %1$@, but only %2$@ can be allocated. Close other apps, reduce Mods, or set memory manually.. %1$@ is the required memory size; %2$@ is the memory size that can be allocated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough memory: this instance needs %1$@, but only %2$@ is available. Close other apps, remove some mods, or set the memory allocation manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算需要 %1$@，但本机只能分配 %2$@。可以关闭其他 App、减少模组，或手动设置内存。"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateTrimmed" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Available memory is limited. The basic requirement of %1$@ is met, but the full headroom (%2$@) is unavailable. Close other apps to estimate again.. %1$@ is the basic memory requirement; %2$@ is the memory size with full recommended headroom.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available memory is limited. The basic requirement of %1$@ is met, but the recommended allocation of %2$@ isn't available. Close other apps, then estimate again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用内存已满足基本需求 %1$@，但不足以分配含全部余量的 %2$@。关闭其他 App 后可以重新估算。"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memorySettingsHelp" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Initial memory cannot exceed maximum memory. Metaspace loads classes and usually needs no limit.. No format arguments.",

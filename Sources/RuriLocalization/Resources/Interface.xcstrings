        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算说明"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateGenericHelp" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Each instance's memory is estimated at launch from its Minecraft version, Loader, Mod count, and available system memory. This shows an example for an instance without Mods.. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri estimates memory for each instance at launch, using its Minecraft version, loader, mod count, and available system memory. The values shown here are an example for an instance without mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时，会根据每个实例的 Minecraft 版本、加载器、模组数量和本机可用内存估算分配大小。此处显示未安装模组的实例作为示例。"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateHelp" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Minecraft version, Loader, and Mod count determine the basic requirement and recommended headroom. System memory and available memory determine an allocation between the two. Headroom covers in-game settings such as render distance, Resource Packs, and Shader Packs.. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri estimates the basic memory requirement and a recommended allocation based on the Minecraft version, loader, and number of mods. It then chooses an amount between the two based on your Mac's total and available memory. The recommended allocation includes room for settings such as render distance, resource packs, and shaders."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据 Minecraft 版本、加载器和模组数量估算基本需求，再按本机内存总量和当前可用内存预留余量。余量用于提高渲染距离、启用资源包或光影等额外开销。"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateSample" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Example: Instance without Mods. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example: Instance without mods"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示例：未安装模组的实例"
          }
        }
      }
    },
    "AppLaunchSettingsEditor.memoryEstimateScanning" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Counting instance content…. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

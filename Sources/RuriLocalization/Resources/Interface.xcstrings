    "AppLaunchSettingsEditor.javaRuntimeHelp" : {
      "comment" : "Shown in the Java, memory, window, and launch settings editor: Launch uses compatible local Java first. If none is available, you can download it or choose local Java. Specifying a major version restricts selection to that version.. No format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruri first looks for a compatible Java installation on your Mac. If none is found, you can download one or locate an existing installation. If you specify a major version, Ruri will use only that version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时优先使用本地兼容的 Java；缺少时会询问是否下载，也可选择本地 Java。指定主版本时仅使用该版本。"
          }
        }

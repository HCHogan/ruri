    },
    "AppLaunchCommandsEditor.availableVariables" : {
      "comment" : "Shown in the custom launch command editor: RURI_GAME_DIRECTORY: Game working directory / RURI_INSTANCE_DIRECTORY: Instance configuration directory / RURI_INSTANCE_NAME / RURI_INSTANCE_ID: Instance name and ID / RURI_GAME_VERSION: Game version / RURI_JAVA: Java executable / RURI_EXIT_CODE / RURI_EXIT_REASON: Game exit code and reason, available only to the post-exit command. No format arguments. Preserve the environment variable names and line breaks; RURI_EXIT_CODE and RURI_EXIT_REASON are only available after exit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RURI_GAME_DIRECTORY: Game run directory\nRURI_INSTANCE_DIRECTORY: Instance configuration directory\nRURI_INSTANCE_NAME / RURI_INSTANCE_ID: Instance name and ID\nRURI_GAME_VERSION: Game version\nRURI_JAVA: Java executable\nRURI_EXIT_CODE / RURI_EXIT_REASON: Game exit code and reason, available only to the post-exit command"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RURI_GAME_DIRECTORY：游戏运行目录\nRURI_INSTANCE_DIRECTORY：实例配置目录\nRURI_INSTANCE_NAME / RURI_INSTANCE_ID：实例名称和标识\nRURI_GAME_VERSION：游戏版本\nRURI_JAVA：Java 可执行文件\nRURI_EXIT_CODE / RURI_EXIT_REASON：游戏退出码和原因，仅退出后命令可用"
          }
        }
      }
    },

    "AppAccountsView.credentials" : {
      "comment" : "Accounts page: Help about Keychain storage and account compatibility with servers. No placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in credentials are stored in the macOS keychain. Third-party accounts work with servers that use their authentication service. Offline accounts can't join servers that verify Minecraft ownership."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录凭据保存在 macOS 钥匙串中。第三方账号可用于支持该认证服务的服务器；离线账号无法加入要求正版验证的服务器。"
          }
        }
      }
    },
